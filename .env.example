# SteamGridDB API Key (https://www.steamgriddb.com/profile/preferences/api)
# Compatible with node-steamgriddb (https://github.com/SteamGridDB/node-steamgriddb)
STEAMGRID_API_KEY=

# IGDB / Twitch API Credentials (https://api-docs.igdb.com/#getting-started)
# 1. Register an application at https://dev.twitch.tv/console/apps
# 2. Set OAuth Redirect URL to http://localhost and Client Type to 'Confidential'
# 3. Paste Client ID and Client Secret below (the app automatically acquires and refreshes Twitch OAuth tokens):
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# (Optional) Pre-generated Twitch OAuth App Access Token if you don't use Client Secret:
IGDB_ACCESS_TOKEN=
